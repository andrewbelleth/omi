{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "omi/arrow-button",
  "version": "1.0.0",
  "title": "矢印ボタン",
  "category": "design",
  "icon": "button",
  "description": "サイト共通の矢印付きボタン。テキストとリンク先を設定できます。",
  "keywords": ["ボタン", "button", "矢印", "CTA", "リンク"],
  "textdomain": "theme-omi",
  "attributes": {
    "text": {
      "type": "string",
      "default": "詳しく見る"
    },
    "url": {
      "type": "string",
      "default": ""
    },
    "linkTarget": {
      "type": "string",
      "default": ""
    },
    "rel": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": ["left", "center", "right"],
    "spacing": {
      "margin": true
    }
  },
  "editorScript": "omi-arrow-button-editor",
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css",
  "render": "file:./render.php"
}
